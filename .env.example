# ==============================================================================
# RozKamai Platform Environment Configuration Template (.env.example)
# Purpose: Defines all environment variables required for the Node.js backend,
# database, security encryption keys, ad network signature secrets, and payout gateways.
# Dev machine: Windows (PowerShell compatible). Copy to .env:
# PowerShell: Copy-Item .env.example .env
# ==============================================================================

# Server Runtime Configuration
PORT=4000
NODE_ENV=development
APP_NAME=RozKamai
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://10.0.2.2:4000

# PostgreSQL Database Configuration (Local Docker Compose or Cloud RDS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rozkamai_db
DB_USER=rozkamai_admin
DB_PASSWORD=rozkamai_secure_pass_2026
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_SSL=false

# Authentication & JWT Secrets (Generate secure random 64-char strings)
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_64_characters_minimum_entropy_here_2026
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_64_characters_minimum_entropy_here_2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=12

# Data Encryption Keys (AES-256-GCM & HMAC-SHA256 for PII / CNIC / Bank Accounts)
# AES key MUST be 32 bytes hex encoded (64 hex characters)
DATA_ENCRYPTION_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
DATA_ENCRYPTION_KEY_ID=v1
# HMAC Blind Index Key (for checking duplicates without decrypting)
DATA_BLIND_INDEX_SALT=super_secret_blind_index_salt_for_pakistani_cnic_and_account_hashes

# Ad Network Server-to-Server (S2S) Callback Verification Secrets
# Unity Ads S2S Callback Secret (Configured in Unity Dashboard -> Monetization -> Server-to-server callbacks)
UNITY_ADS_SECRET=your_unity_ads_s2s_hmac_secret_key
# AppLovin MAX S2S Event Postback Key
APPLOVIN_MAX_SECRET=your_applovin_event_postback_signature_key

# Fraud Prevention & IP Intelligence API (e.g. IPQualityScore, MaxMind, or Mock in Dev)
IP_INTEL_API_KEY=mock_ip_intel_api_key_or_leave_empty_for_dev_mode
IP_INTEL_PROVIDER=mock

# SMS OTP Provider Configuration (e.g. Twilio, SMSAlert.pk, or Mock in Dev)
SMS_PROVIDER=mock
SMS_API_KEY=mock_sms_api_key_for_local_testing

# Logging Configuration
LOG_LEVEL=debug
LOG_PRETTY=true

# Mobile Play Integrity API (Google Cloud Project Service Account path or mock)
PLAY_INTEGRITY_DECRYPTION_KEY=mock_google_play_integrity_decryption_key
